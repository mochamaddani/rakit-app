{
  "name": "rakit-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "env:local": "tsx scripts/write-env-local.ts",
    "test:e2e:app": "PW_APP=1 playwright test --project=app",
    "assets": "tsx scripts/build-assets.ts",
    "assets:check": "tsx scripts/build-assets.ts --check",
    "render": "tsx scripts/render.ts",
    "test:e2e": "playwright test --project=renderer"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "immer": "11.1.21",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "sharp": "0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "21.0.4",
    "html-validate": "11.17.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
